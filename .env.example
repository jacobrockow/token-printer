BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
SCRYFALL_USER_AGENT=token-printer-webapp/0.1

# Local network printer. Leave blank in git; set this in a private .env.
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_WIDTH=576
PRINTER_DPI=203

# Add extra paper after each card for manual tearing. 30 mm = 3 cm.
PRINT_BOTTOM_MARGIN_MM=30

# Leave false while using the manual tear bar. Set true when the cutter is working again.
CUT_AFTER_PRINT=false
